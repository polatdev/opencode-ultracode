    "prepublishOnly": "npm run typecheck && npm run test:runtime"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.15.13"
  },
  "peerDependencies": {
    "@opentui/solid": "^0.5.11",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "@opentui/keymap": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "solid-js": "^1.9.0",
    "zod": "^4.1.8"
  }
}
